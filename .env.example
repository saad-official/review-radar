# Copy to .env (gitignored) and fill in. Every value is optional unless marked.
# scripts/setup-env.sh writes .env for you from the workspace keys and .secrets files.

# --- Models (at least one; Groq is primary, Gemini is the fallback and the embedder) --
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# "gemini" (gemini-embedding-001, 768-d; needs GEMINI_API_KEY) or "hash" (offline, tests only)
EMBEDDING_PROVIDER=gemini

# --- Storage -------------------------------------------------------------------------------
# Postgres with pgvector (Neon). Unset = in-memory store (tests and keyless demo only).
DATABASE_URL=
# Direct (unpooled) URL, used only by `uv run migrate`.
DATABASE_DIRECT_URL=

# --- Writes ----------------------------------------------------------------------------------
# REQUIRED for any write route (create apps, start runs, approve, reject, import).
# The web UI sends it as `Authorization: Bearer <token>`. Generate: openssl rand -hex 24
OPERATOR_TOKEN=
# 32+ random bytes, base64 (openssl rand -base64 32). Encrypts per-app GitHub tokens.
APP_ENCRYPTION_KEY=
# Fallback GitHub token for approved issues (fine-grained PAT, Issues: write, one repo).
GITHUB_TOKEN=

# --- API ---------------------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3600,http://localhost:3000
PORT=7860
# Bearer for GET /api/cron/daily (Vercel Cron sends it automatically).
CRON_SECRET=
IP_HASH_SALT=
TRUST_PROXY_HEADERS=false
RUNS_PER_HOUR_PER_IP=20

# --- Agent run ---------------------------------------------------------------------------------
MAX_REVIEWS_PER_RUN=50
# MAX_USD_PER_RUN=0.10        (default from routing.toml)
PROCESS_TIME_BUDGET_S=240

# --- Run dispatch (serverless) -----------------------------------------------------------------
# Set by Vercel itself; without QStash the client must POST /api/runs/{id}/process.
# VERCEL=1
PUBLIC_API_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Observability (optional) -------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
